{
  "extends": "./tsconfig.json",
  "include": ["client/src/**/*", "shared/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "shared/**/*.test.ts",
    "shared/**/__tests__/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typecheck/client.tsbuildinfo",
    "noEmit": true
  }
}
