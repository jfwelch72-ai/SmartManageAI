{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typecheck/mobile.tsbuildinfo",
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": ["esnext", "dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["mobile/src/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "mobile/src/native-stubs.d.ts",
    "mobile/src/**/*.ts",
    "mobile/src/**/*.tsx",
    "mobile/App.tsx",
    "mobile/index.ts",
    "mobile/app.config.ts"
  ],
  "exclude": ["mobile/node_modules", "node_modules"]
}
