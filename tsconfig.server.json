{
  "extends": "./tsconfig.json",
  "include": [
    "server/**/*",
    "shared/**/*",
    "scripts/fetch-dot-pay-items.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist"
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typecheck/server.tsbuildinfo",
    "noEmit": true
  }
}
