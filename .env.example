# SmartManageAI — Environment Variables
# Copy to `.env` and fill in real values. NEVER commit .env or any real secret.
# See `threat_model.md` § "Secret hygiene & rotation" for the rotation playbook.

# ---------- Required to boot ----------
# Postgres connection string. Replit auto-provisions this in dev; in prod
# point it at the production Neon/Postgres instance.
DATABASE_URL=postgres://user:pass@host:5432/smartmanage

# JWT signing key. The server fails fast on boot if this is missing or empty.
# Rotate quarterly. Rotation invalidates all sessions — schedule it.
SESSION_SECRET=change-me-to-a-32-byte-random-string

# OpenAI API key for embeddings, scheduling, vendor analysis, and the
# default Takeoff AI provider. Required for AI features to work.
OPENAI_API_KEY=sk-...

# Tenant-isolation ratchet (Task #2673). REQUIRED in production: the
# server fails fast on boot when NODE_ENV=production and this is not
# 'true'. With STRICT_TENANT_RLS=true the connect-default
# `app.is_superadmin` flips to 'false' so any DB query that escaped a
# `withOrgContext` wrapper fails closed (returns zero rows) instead of
# silently spanning every tenant. Local dev/test may set this to 'false'
# (or leave it unset) for debugging — boot logs a loud warning. See
# docs/architecture/tenant-isolation.md.
STRICT_TENANT_RLS=true

# ---------- Optional ----------
# Anthropic key. Only required when the org-level feature flag
# `AI_PROVIDER_TAKEOFF` is on for at least one tenant.
ANTHROPIC_API_KEY=

# Task #2948 — BYOK: Master encryption secret for per-org AI provider keys.
# Generate with: openssl rand -hex 32
# Required to enable the "Bring-Your-Own-Key" feature (BYOK_AI_KEYS flag).
# Without this, the BYOK endpoints return 503 and org keys cannot be stored.
KEY_VAULT_SECRET=

# Sentry DSN for production error reporting. Leave blank in dev.
SENTRY_DSN=

# Object Storage paths (set by Replit's Object Storage tool).
PRIVATE_OBJECT_DIR=/replit-objstore-<bucket>/private
PUBLIC_OBJECT_SEARCH_PATHS=/replit-objstore-<bucket>/public

# Upload AV scan boundary (server/uploadAvScanner.ts).
#   - `permissive` (default): default EICAR-signature scanner runs against
#     the first 4 KiB of every confirmed upload; scanner errors are logged
#     but do not block the upload.
#   - `enforce`: same scanner, but scanner errors fail-closed (HTTP 422).
#     Recommended in production once a real scanner is wired via
#     `registerUploadAvScanner(...)`.
#   - `disabled`: no scan at all (legacy behavior). Not recommended.
# Default: `enforce` in production, `permissive` in dev/test. Set
# explicitly to override.
UPLOAD_AV_SCAN_MODE=permissive

# Fail-closed posture for AI prompt-injection guard preconditions
# (e.g. when document extraction fails before the detector can run).
# Default: true in production, false in dev. When true, an
# unevaluable guard surfaces as a hard refusal (FAILED status,
# REFUSED_PROMPT_INJECTION:guard_precondition_failed).
AI_GUARD_FAIL_CLOSED=

# Optional Cloudmersive virus-scan integration. When set, the AV
# boundary swaps the built-in EICAR-only scanner for Cloudmersive's
# hosted ClamAV-backed scan-file endpoint. Files larger than
# CLOUDMERSIVE_AV_MAX_BYTES (default 25 MiB) fall back to EICAR-only.
CLOUDMERSIVE_AV_API_KEY=
CLOUDMERSIVE_AV_MAX_BYTES=26214400

# Email (SendGrid is wired via the `sendgrid` integration; the var is only
# needed for environments that bypass the integration).
SENDGRID_API_KEY=

# CORS / cookie domain. Set FRONTEND_URL when serving the SPA from a
# different origin than the API.
FRONTEND_URL=

# LiveKit (only when the realtime calling feature is enabled).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------- Schedulers ----------
# In dev, schedulers (status probes, AI scheduler, notification sweeper, etc.)
# are off by default to keep local DB load low. Set to "true" to enable.
ENABLE_SCHEDULERS=false

# Dev-only flag: exposes /api/dev/* test endpoints and relaxes the global
# api rate limiter. NEVER set this in production.
ENABLE_DEV_SEED=false

# Per-pod identifier used by the cross-replica messaging bus to ignore its
# own NOTIFY echoes. Auto-generated when unset.
PEER_POD_ID=

# Optional: in tests we swap the pg-backed rate-limit store for in-memory.
RATE_LIMIT_USE_MEMORY_STORE=0

# ---------- Accounting integration sandboxes (Task #2506) ----------
# Used by `e2e/money-accounting-sync.spec.ts` to round-trip an invoice /
# bill against the real QuickBooks Online + Sage Intacct sandboxes. The
# spec auto-skips when any required var below is missing, so leaving
# these blank is safe in dev. CI must populate them as repository
# secrets to actually exercise the round-trip.

# QuickBooks Online sandbox (developer.intuit.com → "Sandboxes").
# Refresh tokens last 100 days; rotate before they expire or the e2e
# spec will fail to mint a fresh access token.
QBO_SANDBOX_CLIENT_ID=
QBO_SANDBOX_CLIENT_SECRET=
QBO_SANDBOX_REFRESH_TOKEN=
QBO_SANDBOX_REALM_ID=
# Optional: customer ID in the sandbox to invoice. Defaults to "1".
QBO_SANDBOX_CUSTOMER_ID=
# Forces the QBO sync layer onto the sandbox base URL. Leave unset (or
# set to anything other than "production") for the e2e spec; the spec
# also asserts this in beforeAll so we can never accidentally point a
# test at a live tenant.
QBO_ENVIRONMENT=sandbox

# Sage Intacct sandbox (Web Services). The sender pair is the
# Sage-issued partner credential; the user pair is the per-tenant
# Web Services user provisioned inside the sandbox company.
SAGE_INTACCT_SANDBOX_SENDER_ID=
SAGE_INTACCT_SANDBOX_SENDER_PASSWORD=
SAGE_INTACCT_SANDBOX_COMPANY_ID=
SAGE_INTACCT_SANDBOX_USER_ID=
SAGE_INTACCT_SANDBOX_USER_PASSWORD=
# Optional: Sage CUSTOMERID to bill in the sandbox.
SAGE_INTACCT_SANDBOX_CUSTOMER_ID=
# Required for the unified /connections/:id/sync dispatcher to allow
# Sage operations. The e2e spec sets this in-process if it is unset
# and the rest of the sandbox creds are present.
INTEGRATION_SAGE=
