[31m+         // override was applied.[39m
[31m+         quantity: item.quantity,[39m
[31m+         unit: item.unit,[39m
[31m+         confidence: (item as any).rawConfidence ?? item.confidence,[39m
[31m+         boundingBoxJson: item.boundingBox ? JSON.stringify(item.boundingBox) : null,[39m
[31m+         status: "PENDING" as const,[39m
