[31m+         }[39m
[31m+       } else {[39m
[31m+         const descA = (current.description || "").toLowerCase();[39m
[31m+         const descB = (other.description || "").toLowerCase();[39m
[31m+         if (descA === descB || (descA.length > 10 && descB.includes(descA.substring(0, 10)))) {[39m
[31m+           current.confidence = Math.max(current.confidence, other.confidence);[39m
[31m+           current.quantity = Math.max(current.quantity, other.quantity);[39m
[31m+           used.add(j);[39m
[31m+         }[39m
