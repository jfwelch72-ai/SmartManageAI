[31m+       INSERT INTO ai_takeoff_confidence_calibration[39m
[31m+         (organization_id, trade_type, model_confidence_bucket,[39m
[31m+          empirical_acceptance_rate, sample_count, updated_at)[39m
[31m+       VALUES[39m
[31m+         (${r.organization_id}, ${r.trade_type}::trade_type, ${r.bucket},[39m
