[31m+ const FEW_SHOT_SAMPLE_LIMIT = 5;[39m
[31m+ const FEW_SHOT_QTY_DELTA_THRESHOLD = 0.1; // 10%[39m
[31m+[39m
[31m+ // Task #2323 — fetches up to N recent EDITED suggestions for the (org, trade)[39m
[31m+ // where the user changed quantity by >10%, and renders them as a compact[39m
[31m+ // "Recent corrections from your team" block. Capped at ~500 tokens. Returns[39m
[31m+ // "" when feature flag is off or no usable corrections exist.[39m
[31m+ async function buildFewShotCorrectionsBlock([39m
[31m+   organizationId: string,[39m
[31m+   tradeType: string,[39m
[31m+ ): Promise<string> {[39m
[31m+   try {[39m
[31m+     const enabled = await isFeatureEnabled(organizationId, "AI_TAKEOFF_FEW_SHOT");[39m
[31m+     if (!enabled) return "";[39m
[31m+[39m
[31m+     const ninetyDaysAgo = new Date(Date.now() - 90 * 24 * 60 * 60 * 1000);[39m
[31m+     const rows = await db.select({[39m
[31m+       itemType: aiTakeoffSuggestions.itemType,[39m
[31m+       description: aiTakeoffSuggestions.description,[39m
[31m+       quantity: aiTakeoffSuggestions.quantity,[39m
[31m+       unit: aiTakeoffSuggestions.unit,[39m
[31m+       editedQuantity: aiTakeoffSuggestions.editedQuantity,[39m
[31m+       editedUnit: aiTakeoffSuggestions.editedUnit,[39m
[31m+     })[39m
[31m+       .from(aiTakeoffSuggestions)[39m
[31m+       .where(and([39m
[31m+         eq(aiTakeoffSuggestions.organizationId, organizationId),[39m
[31m+         eq(aiTakeoffSuggestions.tradeType, tradeType as TradeType),[39m
[31m+         eq(aiTakeoffSuggestions.status, "EDITED"),[39m
[31m+         gte(aiTakeoffSuggestions.reviewedAt, ninetyDaysAgo),[39m
[31m+         isNotNull(aiTakeoffSuggestions.editedQuantity),[39m
[31m+       ))[39m
[31m+       .orderBy(desc(aiTakeoffSuggestions.reviewedAt))[39m
[31m+       .limit(50);[39m
[31m+[39m
