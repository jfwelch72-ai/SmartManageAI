[31m+ // Task #2668 — POST /api/ai-features/takeoff/analyze/:analysisId/cancel[39m
[31m+ // Marks an in-flight analysis as FAILED ("cancelled by user"), best-[39m
[31m+ // effort cancels the underlying pg-boss job, and broadcasts a terminal[39m
[31m+ // SSE event so any connected panels promptly transition out of the[39m
[31m+ // pending state. Idempotent — cancelling an already-terminal row is a[39m
[31m+ // no-op that returns the row's current status.[39m
[31m+ router.post([39m
[31m+   "/ai-features/takeoff/analyze/:analysisId/cancel",[39m
[31m+   requireAuth,[39m
[31m+   // Task #2668 — Mirror the role gate from the analyze endpoint so a[39m
[31m+   // lower-privilege authenticated user (e.g. FIELD_WORKER) cannot[39m
[31m+   // cancel an in-flight takeoff they were never authorized to start.[39m
[31m+   requireRole("ADMIN", "MANAGER", "ESTIMATOR", "SUPERINTENDENT"),[39m
[31m+   async (req: AuthRequest, res, next) => {[39m
[31m+     try {[39m
[31m+       const organizationId = req.user?.organizationId;[39m
[31m+       const userId = req.user?.id;[39m
[31m+       if (!organizationId || !userId) {[39m
[31m+         return res.status(401).json({ error: "Unauthorized" });[39m
[31m+       }[39m
[31m+[39m
[31m+       const [analysis] = await db.select()[39m
[31m+         .from(aiTakeoffAnalyses)[39m
[31m+         .where(and([39m
[31m+           eq(aiTakeoffAnalyses.id, req.params.analysisId),[39m
[31m+           eq(aiTakeoffAnalyses.organizationId, organizationId),[39m
[31m+         ));[39m
[31m+[39m
[31m+       if (!analysis) {[39m
[31m+         return res.status(404).json({ error: "Analysis not found" });[39m
[31m+       }[39m
[31m+[39m
[31m+       if (analysis.status === "COMPLETE" || analysis.status === "FAILED") {[39m
[31m+         return res.json({[39m
[31m+           success: true,[39m
[31m+           analysisId: analysis.id,[39m
[31m+           status: analysis.status,[39m
[31m+           alreadyTerminal: true,[39m
[31m+         });[39m
[31m+       }[39m
[31m+[39m
[31m+       // Task #2668 — atomic transition. The status check above is an[39m
[31m+       // optimization (lets us early-return without writing); the[39m
[31m+       // authoritative race-safe check is the WHERE filter on this[39m
[31m+       // UPDATE. If the worker finished between our SELECT and this[39m
[31m+       // UPDATE, `affected.length === 0` and we must NOT force the row[39m
[31m+       // back to FAILED — re-read and surface the actual terminal[39m
[31m+       // status instead.[39m
[31m+       const cancelMessage = "Analysis cancelled by user";[39m
[31m+       const cancelled = await db.update(aiTakeoffAnalyses)[39m
[31m+         .set({[39m
[31m+           status: "FAILED",[39m
[31m+           errorMessage: cancelMessage,[39m
[31m+           progressMessage: cancelMessage,[39m
[31m+           progressUpdatedAt: new Date(),[39m
[31m+           updatedAt: new Date(),[39m
[31m+         })[39m
[31m+         .where(and([39m
[31m+           eq(aiTakeoffAnalyses.id, analysis.id),[39m
[31m+           inArray(aiTakeoffAnalyses.status, ["PENDING", "PROCESSING"]),[39m
[31m+         ))[39m
[31m+         .returning({ id: aiTakeoffAnalyses.id });[39m
[31m+[39m
[31m+       if (cancelled.length === 0) {[39m
[31m+         // Worker beat us to it — return the now-terminal row's actual[39m
[31m+         // status without publishing a misleading "failed" SSE.[39m
[31m+         const [latest] = await db.select({ status: aiTakeoffAnalyses.status })[39m
[31m+           .from(aiTakeoffAnalyses)[39m
[31m+           .where(eq(aiTakeoffAnalyses.id, analysis.id));[39m
[31m+         return res.json({[39m
[31m+           success: true,[39m
[31m+           analysisId: analysis.id,[39m
[31m+           status: latest?.status ?? analysis.status,[39m
[31m+           alreadyTerminal: true,[39m
[31m+         });[39m
[31m+       }[39m
[31m+[39m
[31m+       // Best-effort: cancel the pg-boss job so the worker stops as soon[39m
[31m+       // as it next checks. We swallow errors because the row has[39m
[31m+       // already been flipped to FAILED — the job becoming a no-op is[39m
[31m+       // an optimization, not a correctness requirement.[39m
[31m+       const jobId = analysis.currentJobId;[39m
[31m+       if (jobId) {[39m
[31m+         try {[39m
[31m+           const { getBoss } = await import("./jobQueue");[39m
[31m+           const boss = getBoss();[39m
[31m+           if (boss && typeof boss.cancel === "function") {[39m
[31m+             // pg-boss `cancel(name, id)` requires the queue name as[39m
[31m+             // the first argument; passing only the id throws at[39m
[31m+             // runtime (and fails our typecheck).[39m
[31m+             await boss.cancel("ai_takeoff_analyze", jobId);[39m
[31m+           }[39m
[31m+         } catch (cancelErr) {[39m
[31m+           logWarn("AI takeoff job cancel best-effort failed", {[39m
[31m+             analysisId: analysis.id,[39m
[31m+             jobId,[39m
[31m+             error: cancelErr instanceof Error ? cancelErr.message : String(cancelErr),[39m
[31m+           });[39m
[31m+         }[39m
[31m+[39m
[31m+         // Publish a terminal SSE so any subscribed panel transitions[39m
[31m+         // out of pending immediately, regardless of whether the worker[39m
[31m+         // actually picks up the cancel.[39m
[31m+         try {[39m
[31m+           const { publishJobProgress } = await import("./jobQueue");[39m
[31m+           await publishJobProgress({[39m
[31m+             jobId,[39m
[31m+             jobName: "ai_takeoff_analyze",[39m
[31m+             organizationId,[39m
[31m+             userId,[39m
[31m+             status: "failed",[39m
[31m+             progress: analysis.progressPct ?? 0,[39m
[31m+             message: cancelMessage,[39m
[31m+           });[39m
[31m+         } catch (publishErr) {[39m
[31m+           logWarn("AI takeoff cancel SSE publish failed", {[39m
[31m+             analysisId: analysis.id,[39m
[31m+             jobId,[39m
[31m+             error: publishErr instanceof Error ? publishErr.message : String(publishErr),[39m
[31m+           });[39m
[31m+         }[39m
[31m+       }[39m
[31m+[39m
[31m+       return res.json({[39m
[31m+         success: true,[39m
[31m+         analysisId: analysis.id,[39m
[31m+         status: "FAILED",[39m
[31m+         cancelled: true,[39m
[31m+       });[39m
[31m+     } catch (error) {[39m
[31m+       next(error);[39m
[31m+     }[39m
[31m+   },[39m
[31m+ );[39m
[31m+[39m
[31m+ router.get("/ai-features/takeoff/history/:contextId", requireAuth, async (req: AuthRequest, res, next) => {[39m
[31m+   try {[39m
[31m+     const organizationId = req.user?.organizationId;[39m
[31m+     if (!organizationId) {[39m
[31m+       return res.status(401).json({ error: "Unauthorized" });[39m
[31m+     }[39m
[31m+[39m
[31m+     const contextId = req.params.contextId;[39m
[31m+     const contextType = req.query.type as string || "project";[39m
[31m+[39m
[31m+     const conditions = [[39m
[31m+       eq(aiTakeoffAnalyses.organizationId, organizationId),[39m
[31m+     ];[39m
[31m+[39m
[31m+     if (contextType === "bid") {[39m
[31m+       conditions.push(eq(aiTakeoffAnalyses.bidId, contextId));[39m
[31m+     } else if (contextType === "standalone") {[39m
[31m+       // Task #2551 — standalone-takeoff scoped history.[39m
[31m+       conditions.push(eq(aiTakeoffAnalyses.standaloneTakeoffId, contextId));[39m
[31m+     } else {[39m
[31m+       conditions.push(eq(aiTakeoffAnalyses.projectId, contextId));[39m
[31m+     }[39m
[31m+[39m
[31m+     const analyses = await db.select()[39m
[31m+       .from(aiTakeoffAnalyses)[39m
[31m+       .where(and(...conditions))[39m
[31m+       .orderBy(desc(aiTakeoffAnalyses.createdAt))[39m
[31m+       .limit(20);[39m
[31m+[39m
[31m+     res.json({ analyses });[39m
[31m+   } catch (error) {[39m
[31m+     next(error);[39m
[31m+   }[39m
[31m+ });[39m
