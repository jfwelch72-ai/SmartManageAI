[31m+       const userId = req.user?.id;[39m
[31m+       if (!organizationId || !userId) return res.status(401).json({ error: "Unauthorized" });[39m
[31m+[39m
[31m+       const parsed = rejectBodySchema.safeParse(req.body ?? {});[39m
