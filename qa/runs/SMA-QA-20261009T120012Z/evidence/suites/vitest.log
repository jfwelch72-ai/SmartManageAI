[31m+ function computeBBoxOverlap(a: { x: number; y: number; w: number; h: number }, b: { x: number; y: number; w: number; h: number }): number {[39m
[31m+   const x1 = Math.max(a.x, b.x);[39m
[31m+   const y1 = Math.max(a.y, b.y);[39m
[31m+   const x2 = Math.min(a.x + a.w, b.x + b.w);[39m
[31m+   const y2 = Math.min(a.y + a.h, b.y + b.h);[39m
[31m+[39m
[31m+   if (x2 <= x1 || y2 <= y1) return 0;[39m
[31m+[39m
[31m+   const intersectionArea = (x2 - x1) * (y2 - y1);[39m
[31m+   const aArea = a.w * a.h;[39m
[31m+   const bArea = b.w * b.h;[39m
[31m+   const unionArea = aArea + bArea - intersectionArea;[39m
[31m+[39m
[31m+   return unionArea > 0 ? intersectionArea / unionArea : 0;[39m
[31m+ }[39m
