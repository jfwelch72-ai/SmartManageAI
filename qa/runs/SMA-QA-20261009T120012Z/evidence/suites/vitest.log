[31m+[39m
[31m+       const parsed = bulkAcceptBodySchema.safeParse(req.body ?? {});[39m
[31m+       if (!parsed.success) {[39m
[31m+         return res.status(400).json({ error: "Invalid body", details: parsed.error.flatten() });[39m
[31m+       }[39m
