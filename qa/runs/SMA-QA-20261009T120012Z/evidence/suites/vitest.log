  projectLogEmailScheduleTask = scheduleCron(\"project_log_email_schedules\", \"0 1 * * * *\", async () => {
    // Task #1951 — overlap guard. The hourly sweep builds RFI /
    // submittal PDFs and emails them to per-project distribution
