[31m+[39m
[31m+     if (usable.length === 0) return "";[39m
[31m+[39m
[31m+     const lines = usable.map((r) => {[39m
[31m+       const unit = r.editedUnit || r.unit;[39m
[31m+       const arrow = `${r.quantity} ${r.unit} -> ${r.editedQuantity} ${unit}`;[39m
[31m+       const desc = (r.description || r.itemType || "").slice(0, 80);[39m
[31m+       return `- "${desc}": ${arrow}`;[39m
[31m+     });[39m
[31m+[39m
[31m+     return `\nRecent corrections from your team (apply these patterns):\n${lines.join("\n")}\n`;[39m
[31m+   } catch (err) {[39m
[31m+     logError([39m
[31m+       "Few-shot corrections lookup failed (non-fatal):",[39m
[31m+       { organizationId, tradeType },[39m
[31m+       err instanceof Error ? err : new Error(String(err)),[39m
[31m+     );[39m
[31m+     return "";[39m
[31m+   }[39m
[31m+ }[39m
