    projectLogEmailScheduleTickRunning = true;
    try {
      await withSchedulerLock(\"job:projectLogEmailScheduleTask\", async () => {
        await processProjectLogEmailSchedules();
        recordJobOutcome(\"project_log_email_schedules\", true);
      });
    } catch (err) {
      recordJobOutcome(\"project_log_email_schedules\", false);
      logJobErrorWithKind(\"project_log_email_schedules\", \"Project log email schedule sweep failed\", err);
    } finally {
      projectLogEmailScheduleTickRunning = false;
    }
  });

  // Task #1715: digest to org ADMIN / SUPER_ADMIN users summarising
  // every schedule whose latest attempt was FAILURE / NO_RECIPIENTS —
  // same conditions as the rows on /admin/log-email-failures. Catches
  // broken distribution lists proactively so admins don't have to
  // remember to open the dashboard.
  //
  // Task #1732: cron now ticks hourly. Each org has its own
  // cadence/hour/weekday/timezone (columns on `organizations`,
  // defaults DAILY @ 08:00 UTC) and the per-org gate inside the
  // handler picks which orgs (if any) actually fan out on each tick.
  // The dedupe sentinel inside the handler ensures a re-run within
  // the same local day (manual fire, boot during the firing minute)
  // doesn't re-send.
  projectLogEmailFailuresDigestTask = scheduleCron(\"project_log_email_failures_digest\", \"30 1 * * * *\", async () => {
    // Task #1951 — overlap guard. Same family as the hourly schedule
    // sweep above: the failures digest fans an email to every org's
    // ADMIN / SUPER_ADMIN users, gated by per-org cadence + dedupe.
    // A stacked tick would race the dedupe sentinel and risk
    // duplicate digests during the firing minute.
    if (projectLogEmailFailuresDigestTickRunning) {
      logWarn(\"Project log email failures digest skipped: previous tick still running\");
      recordJobSkipped(\"project_log_email_failures_digest\");
      return;
    }
    projectLogEmailFailuresDigestTickRunning = true;
    try {
      await withSchedulerLock(\"job:projectLogEmailFailuresDigestTask\", async () => {
        await processProjectLogEmailFailuresDigest();
        recordJobOutcome(\"project_log_email_failures_digest\", true);
      });
    } catch (err) {
      recordJobOutcome(\"project_log_email_failures_digest\", false);
      logJobErrorWithKind(\"project_log_email_failures_digest\", \"Project log email failures digest sweep failed\", err);
    } finally {
      projectLogEmailFailuresDigestTickRunning = false;
    }
  });

  // Task #1173: nightly sweep that finds OPEN SWPPP inspections whose
  // corrective action due date has passed and notifies the assigned
  // assignee + the project manager once per overdue cycle. Runs at 7am
  // alongside the existing compliance/expiration checks.
  swpppOverdueTask = scheduleCron(\"swppp_overdue_corrective_actions\", \"20 0 7 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:swpppOverdueTask\", async () => {
        await processSwpppOverdueCorrectiveActions();
        recordJobOutcome(\"swppp_overdue_corrective_actions\", true);
      });
    } catch (err) {
      recordJobOutcome(\"swppp_overdue_corrective_actions\", false);
      logError(\"SWPPP overdue corrective action sweep failed\", { error: String(err) });
    }
  });

  // Task #1599: nightly sweep that finds open RFIs whose `dateRequired`
  // has passed and notifies the assignee + project manager. Same 7am
  // cadence as the SWPPP sweep and uses the same per-row dedupe marker
  // + counter pattern so each overdue cycle generates one initial
  // fanout plus N follow-up reminders (per-org cap).
  rfiOverdueTask = scheduleCron(\"rfi_overdue_notifications\", \"40 0 7 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:rfiOverdueTask\", async () => {
        await processRfiOverdueNotifications();
        recordJobOutcome(\"rfi_overdue_notifications\", true);
      });
    } catch (err) {
      recordJobOutcome(\"rfi_overdue_notifications\", false);
      logError(\"RFI overdue notification sweep failed\", { error: String(err) });
    }
  });

  // Task #1599: companion sweep for submittal_reviews. The PENDING /
  // IN_REVIEW review whose parent submittal is past its date_required
  // is what we treat as overdue; the assigned reviewer + project
  // manager get the fanout.
  submittalReviewOverdueTask = scheduleCron(\"submittal_overdue_notifications\", \"0 1 7 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:submittalReviewOverdueTask\", async () => {
        await processSubmittalReviewOverdueNotifications();
        recordJobOutcome(\"submittal_overdue_notifications\", true);
      });
    } catch (err) {
      recordJobOutcome(\"submittal_overdue_notifications\", false);
      logError(\"Submittal review overdue notification sweep failed\", { error: String(err) });
    }
  });

  // Task #1178: nightly cleanup at 03:30 UTC — hard-deletes archived
  // certified payroll PDFs (and their object-storage blobs) older than
  // each org's configured retention window. Runs after the 02:00 retention
  // job and well before business hours so the daily storage cost reclaim
  // shows up in tomorrow's metrics.
  certifiedPayrollPurgeTask = scheduleCron(\"certified_payroll_purge\", \"20 30 3 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:certifiedPayrollPurgeTask\", async () => {
        const result = await processArchivedCertifiedPayrollPurge();
        if (result.rowsPurged > 0) {
          logInfo(\"Archived certified payroll auto-purge run\", result);
        }
        recordJobOutcome(\"certified_payroll_purge\", true);
      });
    } catch (err) {
      recordJobOutcome(\"certified_payroll_purge\", false);
      logError(\"Archived certified payroll auto-purge failed\", { error: String(err) });
    }
  });

  // Task #693: daily morning email reminder routed to each contact's owner
  // (createdById) so account managers see today's birthdays without having to
  // open the CRM. Per-user opt-in/opt-out is handled by the existing
  // notificationTypePrefs (email channel for REMINDER notifications).
  crmBirthdayDailyTask = scheduleCron(\"crm_birthday_daily_digest\", \"20 1 7 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:crmBirthdayDailyTask\", async () => {
        await processCrmContactBirthdayDailyDigest();
        recordJobOutcome(\"crm_birthday_daily_digest\", true);
      });
    } catch (err) {
      recordJobOutcome(\"crm_birthday_daily_digest\", false);
      logError(\"CRM contact birthday daily digest failed\", { error: String(err) });
    }
  });

  // Task #1354 + #1368: every 5 minutes, re-attempt every failed
  // integration sync (Davis-Bacon wage decisions, QBO scheduled exports,
  // and any other provider that opts into the generic retry helper)
  // whose backoff window is due. Successful retries clear the failure
  // state so banners/notifications resolve naturally; exhausted rows are
  // left alone for manual intervention.
  wageDecisionRetryTask = scheduleCron(\"integration_sync_retry\", \"40 */5 * * * *\", async () => {
    // Task #1951 — overlap guard. The retry sweep walks every failed
    // integration sync row whose backoff is due (Davis-Bacon, QBO,
    // Sage, etc.) and replays the underlying provider call; a slow
    // upstream can plausibly outlast 5 minutes and stack onto the
    // next tick, doubling provider load and pool pressure.
    if (integrationSyncRetryTickRunning) {
      logWarn(\"Integration sync retry sweep skipped: previous tick still running\");
      recordJobSkipped(\"integration_sync_retry\");
      return;
    }
    integrationSyncRetryTickRunning = true;
    try {
      await withSchedulerLock(\"job:wageDecisionRetryTask\", async () => {
        const out = await processIntegrationSyncRetries();
        if (out.attempted > 0) {
          logInfo(\"Integration sync retry sweep\", out);
        }
      });
    } catch (err) {
      logJobErrorWithKind(\"integration_sync_retry\", \"Integration sync retry sweep failed\", err);
    } finally {
      integrationSyncRetryTickRunning = false;
    }
  });

  // Task #1380: once a day, re-sync every cached Davis-Bacon wage
  // determination whose lastSyncAt has crossed the configured staleness
  // threshold (DOL_DAVIS_BACON_STALE_AFTER_DAYS, default 30 days). Picks
  // 06:00 UTC so the refresh lands well before the morning payroll run
  // window in US timezones. The sweep itself skips rows currently in
  // the failure-backoff lane, so it cannot hammer DOL when prior
  // attempts failed.
  wageDecisionStaleRefreshTask = scheduleCron(\"wage_decision_stale_refresh\", \"0 0 6 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:wageDecisionStaleRefreshTask\", async () => {
        const out = await processStaleWageDecisions();
        if (out.candidates > 0) {
          logInfo(\"Davis-Bacon stale wage decision refresh sweep\", out);
        }
      });
    } catch (err) {
      logError(\"Davis-Bacon stale wage decision refresh failed\", { error: String(err) });
    }
  });

  // Task #1512: nightly retention sweep for the
  // `integration_suppression_resets` table. The integrations panel only
  // ever reads the most recent N rows per org, so anything older than
  // INTEGRATION_SUPPRESSION_RESET_RETENTION_DAYS (default 90 days) is
  // dead weight that will eventually slow down inserts/queries on busy
  // orgs. Runs at 03:45 UTC alongside the other nightly cleanup jobs.
  suppressionResetPruneTask = scheduleCron(\"suppression_reset_prune\", \"0 45 3 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:suppressionResetPruneTask\", async () => {
        const deleted = await pruneSuppressionResets();
        if (deleted > 0) {
          logInfo(\"Suppression-reset retention sweep\", { deleted });
        }
        recordJobOutcome(\"suppression_reset_prune\", true);
      });
    } catch (err) {
      recordJobOutcome(\"suppression_reset_prune\", false);
      logError(\"Suppression-reset retention sweep failed\", { error: String(err) });
    }
  });

  // Task #1665: nightly retention sweep for
  // `project_log_email_schedule_attempts`. Every cron tick + manual
  // send writes a row, but the project settings UI only ever surfaces
  // the most recent 10 (max 50) per schedule, so anything older than
  // PROJECT_LOG_EMAIL_ATTEMPT_DEFAULT_RETENTION_DAYS (90) is dead
  // weight. Batched inside the helper so a large tenant can't hold
  // long row-level locks. Runs at 04:00 UTC alongside the other
  // nightly cleanup jobs.
  projectLogEmailAttemptPruneTask = scheduleCron(\"project_log_email_attempt_prune\", \"0 0 4 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:projectLogEmailAttemptPruneTask\", async () => {
        const result = await pruneProjectLogEmailScheduleAttempts();
        if (result.deleted > 0 || result.cappedAtMaxBatches) {
          logInfo(\"Project log email attempt-history retention sweep\", {
            deleted: result.deleted,
            batches: result.batches,
            cappedAtMaxBatches: result.cappedAtMaxBatches,
          });
        }
        recordJobOutcome(\"project_log_email_attempt_prune\", true);
      });
    } catch (err) {
      recordJobOutcome(\"project_log_email_attempt_prune\", false);
      logError(\"Project log email attempt-history retention sweep failed\", { error: String(err) });
    }
  });

  // Task #1846: nightly hard-delete sweep for soft-deleted
  // `plan_document_markups` rows whose `deleted_at` is older than the
  // configured retention window (default 30 days). Runs at 04:15 UTC,
  // just after the project-log attempt-history prune so the two
  // batched table sweeps don't overlap. Batched inside the helper so
  // a large tenant can't hold long row-level locks.
  planDocumentMarkupTrashPurgeTask = scheduleCron(\"plan_document_markup_trash_purge\", \"0 15 4 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:planDocumentMarkupTrashPurgeTask\", async () => {
        const result = await purgePlanDocumentMarkupTrash();
        if (result.deleted > 0 || result.cappedAtMaxBatches) {
          logInfo(\"Plan document markup trash purge sweep\", {
            deleted: result.deleted,
            batches: result.batches,
            cappedAtMaxBatches: result.cappedAtMaxBatches,
            durationMs: result.durationMs,
          });
        }
        recordJobOutcome(\"plan_document_markup_trash_purge\", true);
      });
    } catch (err) {
      recordJobOutcome(\"plan_document_markup_trash_purge\", false);
      logError(\"Plan document markup trash purge sweep failed\", { error: String(err) });
    }
  });

  // Task #2129: nightly safety-net sweep for `takeoff_recents`. Runs at
  // 04:45 UTC, after the plan-document markup trash purge (04:15) and
  // the project geocode sweep (04:30), keeping the nightly cleanup
  // jobs staggered so they don't pile onto the Postgres pool at the
  // same minute. The DELETE hooks in `bidRoutes2.ts` /
  // `projectCrudRoutes.ts` already prune in the common path; this
  // sweep catches any row that slipped past those hooks (raw-SQL
  // migration, admin script, partial mid-delete failure) so the
  // per-user 24-entry cap doesn't quietly fill up with orphans. Logs
  // per-kind counts so ops can see immediately if a delete hook ever
  // silently regresses (a sustained non-zero count is the signal).
  takeoffRecentsOrphanPruneTask = scheduleCron(\"takeoff_recents_orphan_prune\", \"0 45 4 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:takeoffRecentsOrphanPruneTask\", async () => {
        const out = await pruneOrphanedTakeoffRecents();
        // Log every tick — including the \"nothing to prune\" path — so
        // ops have a visible per-run heartbeat in the logs and a
        // sustained non-zero count is immediately spottable as a
        // regressed delete hook (rather than being inferred from the
        // absence of a \"0 rows\" line).
        logInfo(\"Takeoff recents orphan sweep\", {
          bidRowsPruned: out.bidRowsPruned,
          projectRowsPruned: out.projectRowsPruned,
          totalPruned: out.totalPruned,
          durationMs: out.durationMs,
        });
        recordJobOutcome(\"takeoff_recents_orphan_prune\", true);
      });
    } catch (err) {
      recordJobOutcome(\"takeoff_recents_orphan_prune\", false);
      logError(\"Takeoff recents orphan sweep failed\", { error: String(err) });
    }
  });

  // Task #1948: quarterly refresh of every verbatim DOT pay-item
  // catalog. Runs at 04:00 UTC on the 1st of Jan/Apr/Jul/Oct so it
  // lands well outside North-American business hours. The handler is
  // idempotent (the underlying fetcher refuses to overwrite a JSON
  // when the parse fails its guards) and emits a single per-agency
  // delta log line + an email to the on-call rotation when a catalog
  // drops below its `AGENCY_MIN_ITEMS` threshold.
  dotPayItemsRefreshTask = scheduleCron(\"dot_pay_items_refresh\", \"40 0 4 1 1,4,7,10 *\", async () => {
    try {
      await withSchedulerLock(\"job:dotPayItemsRefreshTask\", async () => {
        // Task #1962 — `processDotPayItemsRefresh` now records its own
        // per-tick `job_metric_samples` row (with both numeric counters
        // *and* per-agency / regression detail in the JSONB column) so the
        // Super Admin DOT pay-item refresh history page can render run
        // history. We no longer need to double-record numeric counters here.
        const out = await processDotPayItemsRefresh();
        logInfo(\"DOT pay-item quarterly refresh tick\", {
          agenciesProcessed: out.agenciesProcessed,
          successes: out.successes,
          failures: out.failures,
          regressions: out.regressions,
          alertsSent: out.alertsSent,
        });
      });
    } catch (err) {
      recordJobOutcome(\"dot_pay_items_refresh\", false);
      logError(\"DOT pay-item quarterly refresh failed\", { error: String(err) });
    }
  });

  // Task #1344: daily 08:00 UTC fan-out reminder to org admins about
  // projects whose Davis-Bacon wage decision has been missing for >24h.
  // The handler itself enforces a 1-per-project-per-week throttle so a
  // daily cadence is the right responsiveness without spamming admins.
  wageDecisionMissingReminderTask = scheduleCron(\"wage_decision_missing_reminder\", \"40 0 8 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:wageDecisionMissingReminderTask\", async () => {
        const out = await processMissingWageDecisionReminders();
        if (out.remindersSent > 0) {
          logInfo(\"Wage decision missing reminder sweep\", out);
        }
        recordJobOutcome(\"wage_decision_missing_reminder\", true);
      });
    } catch (err) {
      recordJobOutcome(\"wage_decision_missing_reminder\", false);
      logError(\"Wage decision missing reminder sweep failed\", { error: String(err) });
    }
  });

  // Task #2323: nightly AI takeoff confidence calibration. Runs at
  // 03:30 UTC — well outside North-American business hours and not
  // colliding with the 03:00 takeoff-recents prune. The recompute is
  // a single GROUP BY + per-bucket UPSERT and finishes in <1s for
  // typical orgs, so we don't bother with overlap guards.
  aiTakeoffCalibrationTask = scheduleCron(\"ai_takeoff_calibration\", \"0 30 3 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:aiTakeoffCalibrationTask\", async () => {
        const { runAiTakeoffCalibrationJob } = await import(\"../aiTakeoffFeatureRoutes\");
        const out = await runAiTakeoffCalibrationJob();
        logInfo(\"AI takeoff calibration tick\", { rowsUpserted: out.rowsUpserted });
        recordJobOutcome(\"ai_takeoff_calibration\", true);
      });
    } catch (err) {
      recordJobOutcome(\"ai_takeoff_calibration\", false);
      logError(\"AI takeoff calibration failed\", { error: String(err) });
    }
  });

  // Task #2339: nightly AI Estimator learning ingestion. Runs at 02:45 UTC
  // — after the retention sweep (02:00) and the portfolio KPI snapshot
  // (02:15) but before the AI takeoff calibration (03:30) and the
  // takeoff-recents orphan prune (04:45) so the ingestion has a clear
  // window. The handler iterates every active AI_ESTIMATOR-enabled org
  // and fans out to `runIngestion(...)`; per-org cooldown / in-flight
  // checks live inside `processAiEstimatorScheduledIngestion`. The
  // ingestion runner records its own per-org row in
  // `ai_estimator_ingest_runs` (including FAILED rows with the error
  // message) so the admin page surfaces failures without grepping logs.
  aiEstimatorIngestionTask = scheduleCron(\"ai_estimator_ingestion\", \"0 45 2 * * *\", async () => {
    if (aiEstimatorIngestionTickRunning) {
      logWarn(\"AI Estimator scheduled ingestion skipped: previous tick still running\");
      recordJobSkipped(\"ai_estimator_ingestion\");
      return;
    }
    aiEstimatorIngestionTickRunning = true;
    try {
      await withSchedulerLock(\"job:aiEstimatorIngestionTask\", async () => {
        const out = await processAiEstimatorScheduledIngestion();
        recordJobMetrics(\"ai_estimator_ingestion\", {
          succeeded: out.orgsSucceeded,
          failed: out.orgsFailed,
          triggered: out.orgsTriggered,
          skippedRecent: out.orgsSkippedRecent,
          skippedInFlight: out.orgsSkippedInFlight,
          skippedNotEnabled: out.orgsSkippedNotEnabled,
          durationMs: out.durationMs,
        });
      });
    } catch (err) {
      recordJobOutcome(\"ai_estimator_ingestion\", false);
      logJobErrorWithKind(\"ai_estimator_ingestion\", \"AI Estimator scheduled ingestion failed\", err);
    } finally {
      aiEstimatorIngestionTickRunning = false;
    }
  });

  // Task #2628 — nightly AI takeoff calibration feedback loop. Runs at
  // 04:00 UTC, after both the ingestion (02:45) and the confidence
  // calibration (03:30), so the few-shot exemplar set + per-trade
  // bias nudges are computed against the freshest review state.
  aiTakeoffCalibrationAggregatorTask = scheduleCron(\"ai_takeoff_calibration_aggregator\", \"20 0 4 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:aiTakeoffCalibrationAggregatorTask\", async () => {
        const { runCalibrationAggregator } = await import(\"../services/aiEstimator/calibrationLoop\");
        const out = await runCalibrationAggregator();
        recordJobMetrics(\"ai_takeoff_calibration_aggregator\", {
          succeeded: out.orgsRefreshed,
          failed: 0,
          triggered: out.orgsConsidered,
          durationMs: out.durationMs,
        });
        logInfo(\"AI takeoff calibration aggregator tick\", out);
      });
    } catch (err) {
      recordJobOutcome(\"ai_takeoff_calibration_aggregator\", false);
      logJobErrorWithKind(
        \"ai_takeoff_calibration_aggregator\",
        \"AI takeoff calibration aggregator failed\",
        err,
      );
    }
  });

  // Task #2496 — nightly equipment preventative-maintenance work order
  // generation. Daily at 03:30 UTC; per-org loop wrapped in
  // `withJobOrgContext` so RLS keeps each tick scoped to one tenant.
  equipmentPmGenerationTask = scheduleCron(\"equipment_pm_generation\", \"40 30 3 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:equipmentPmGenerationTask\", async () => {
        const summary = await processEquipmentPmGeneration();
        recordJobOutcome(\"equipment_pm_generation\", summary.failed === 0);
        logInfo(\"Equipment PM generation sweep\", summary);
      });
    } catch (err) {
      recordJobOutcome(\"equipment_pm_generation\", false);
      logJobErrorWithKind(\"equipment_pm_generation\", \"Equipment PM generation failed\", err);
    }
  });

  // Task #2690 — hourly audit job that scans equipment_repairs for
  // duplicate active rows per (schedule_id, pm_cycle_key). The partial
  // unique index makes this impossible to insert via the engine, so a
  // non-zero count signals either (a) a manual SQL write that bypassed
  // the engine, or (b) an index that was dropped/disabled. Logged at
  // WARN so it shows up on the observability dashboard.
  pmDuplicateAuditTask = scheduleCron(\"pm_duplicate_audit\", \"30 17 * * * *\", async () => {
    try {
      await withSchedulerLock(\"job:pmDuplicateAudit\", async () => {
        const summary = await auditPmWorkOrderDuplicates();
        recordJobOutcome(\"pm_duplicate_audit\", true);
        if (summary.duplicateGroups > 0) {
          logWarn(\"PM duplicate audit found duplicates\", summary);
        } else {
          logInfo(\"PM duplicate audit clean\", summary);
        }
      });
    } catch (err) {
      recordJobOutcome(\"pm_duplicate_audit\", false);
      logJobErrorWithKind(\"pm_duplicate_audit\", \"PM duplicate audit failed\", err);
    }
  });

  // Task #2668 — every minute, sweep ai_takeoff_analyses for rows
  // whose last persisted progress tick is older than the configured
  // stall window. Flip them to FAILED and broadcast a terminal SSE so
  // any subscribed AI Auto-Takeoff panel transitions out of pending.
  aiTakeoffStallWatchdogTask = scheduleCron(\"ai_takeoff_stall_watchdog\", \"30 * * * * *\", async () => {
    try {
      await withSchedulerLock(\"job:aiTakeoffStallWatchdog\", async () => {
        const summary = await processAiTakeoffStallWatchdog();
        recordJobOutcome(\"ai_takeoff_stall_watchdog\", true);
        if (summary.flagged > 0) {
          logInfo(\"AI takeoff stall watchdog flagged stalled rows\", summary);
        }
      });
    } catch (err) {
      recordJobOutcome(\"ai_takeoff_stall_watchdog\", false);
      logJobErrorWithKind(\"ai_takeoff_stall_watchdog\", \"AI takeoff stall watchdog failed\", err);
    }
  });

  // Task #2833 — every 5 minutes, scan for pg-boss jobs that have been
  // stuck in 'active' state longer than STUCK_JOB_THRESHOLD_MS (default 30 min).
  // Logs a WARN and increments a counter so the job-metric alert engine can page.
  stuckJobWatchdogTask = scheduleCron(\"stuck_job_watchdog\", \"*/5 * * * *\", async () => {
    try {
      await withSchedulerLock(\"job:stuckJobWatchdog\", async () => {
        await processStuckJobWatchdog();
        recordJobOutcome(\"stuck_job_watchdog\", true);
      });
    } catch (err) {
      recordJobOutcome(\"stuck_job_watchdog\", false);
      logJobErrorWithKind(\"stuck_job_watchdog\", \"Stuck job watchdog failed\", err);
    }
  });

  // Task #2833 — daily change order overdue notification sweep (07:30)
  changeOrderOverdueTask = scheduleCron(\"change_order_overdue_notifications\", \"0 30 7 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:changeOrderOverdueNotifications\", async () => {
        await processChangeOrderOverdueNotifications();
        recordJobOutcome(\"change_order_overdue_notifications\", true);
      });
    } catch (err) {
      recordJobOutcome(\"change_order_overdue_notifications\", false);
      logJobErrorWithKind(\"change_order_overdue_notifications\", \"Change order overdue notifications failed\", err);
    }
  });

  // Task #2833 — daily workflow SLA breach sweep
  workflowSlaBreachTask = scheduleCron(\"workflow_sla_breach_sweep\", \"0 0 7 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:workflowSlaBreachSweep\", async () => {
        const { processWorkflowSlaBreach } = await import(\"../services/workflowEngine\");
        const result = await processWorkflowSlaBreach();
        recordJobOutcome(\"workflow_sla_breach_sweep\", true);
        if (result.breached > 0) {
          logInfo(\"Workflow SLA breach sweep complete\", result);
        }
      });
    } catch (err) {
      recordJobOutcome(\"workflow_sla_breach_sweep\", false);
      logJobErrorWithKind(\"workflow_sla_breach_sweep\", \"Workflow SLA breach sweep failed\", err);
    }
  });

  // Fix-list #4 — daily executive-digest fan-out (06:30 local)
  dailyExecutiveDigestTask = scheduleCron(\"daily_executive_digest\", \"0 30 6 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:dailyExecutiveDigest\", async () => {
        await processDailyExecutiveDigest();
        recordJobOutcome(\"daily_executive_digest\", true);
      });
    } catch (err) {
      recordJobOutcome(\"daily_executive_digest\", false);
      logJobErrorWithKind(\"daily_executive_digest\", \"Daily executive digest fan-out failed\", err);
    }
  });

  // Fix-list #6 — weekly retainage collection reminder (Mon 08:00 local)
  retainageReminderTask = scheduleCron(\"retainage_collection_reminder\", \"0 0 8 * * 1\", async () => {
    try {
      await withSchedulerLock(\"job:retainageReminder\", async () => {
        await processRetainageCollectionReminders();
        recordJobOutcome(\"retainage_collection_reminder\", true);
      });
    } catch (err) {
      recordJobOutcome(\"retainage_collection_reminder\", false);
      logJobErrorWithKind(\"retainage_collection_reminder\", \"Retainage collection reminder failed\", err);
    }
  });

  // Fix-list #7 — weekly unbilled approved-CO reminder (Tue 08:00 local)
  unbilledChangeOrderReminderTask = scheduleCron(\"unbilled_change_order_reminder\", \"0 0 8 * * 2\", async () => {
    try {
      await withSchedulerLock(\"job:unbilledChangeOrderReminder\", async () => {
        await processUnbilledChangeOrderReminders();
        recordJobOutcome(\"unbilled_change_order_reminder\", true);
      });
    } catch (err) {
      recordJobOutcome(\"unbilled_change_order_reminder\", false);
      logJobErrorWithKind(\"unbilled_change_order_reminder\", \"Unbilled CO reminder failed\", err);
    }
  });

  // Fix-list #8 — weekly lien-waiver outstanding reminder (Wed 08:00 local)
  lienWaiverReminderTask = scheduleCron(\"lien_waiver_reminder\", \"0 0 8 * * 3\", async () => {
    try {
      await withSchedulerLock(\"job:lienWaiverReminder\", async () => {
        await processLienWaiverReminders();
        recordJobOutcome(\"lien_waiver_reminder\", true);
      });
    } catch (err) {
      recordJobOutcome(\"lien_waiver_reminder\", false);
      logJobErrorWithKind(\"lien_waiver_reminder\", \"Lien waiver reminder failed\", err);
    }
  });

  // Fix-list #9 — daily backfill of default notification channel prefs for
  // admin/manager/super-admin users that don't yet have a row. Runs at
  // 03:30 to also pick up users created/role-changed during the day.
  adminNotificationPrefsBackfillTask = scheduleCron(\"admin_notification_prefs_backfill\", \"0 30 3 * * *\", async () => {
    try {
      await withSchedulerLock(\"job:adminNotificationPrefsBackfill\", async () => {
        const n = await processAdminNotificationPrefsBackfill();
        recordJobOutcome(\"admin_notification_prefs_backfill\", true);
        if (n > 0) logInfo(\"Default notification prefs backfilled\", { inserted: n });
      });
    } catch (err) {
      recordJobOutcome(\"admin_notification_prefs_backfill\", false);
      logJobErrorWithKind(\"admin_notification_prefs_backfill\", \"Default notification prefs backfill failed\", err);
    }
  });

  // Run the backfill once on boot so newly-promoted admins on a long-
  // lived process get prefs without waiting for the 03:30 tick.
  (async () => {
    try {
      const n = await processAdminNotificationPrefsBackfill();
      if (n > 0) logInfo(\"Default notification prefs backfilled at boot\", { inserted: n });
    } catch (err) {
      logError(\"Default notification prefs boot backfill failed\", { error: String(err) });
    }
  })();

  logInfo(\"Background job runner started (with retention, sync, social post, token expiry, compliance, profitability monitor, idle opportunity, orphan upload, bid due date, IMAP email sync, provider email sync, provider push-back drain, periodic report, DB health check, scheduled campaign, project geocoding, weekly CRM birthday digest, daily CRM birthday email, equipment PM generation, AI takeoff stall watchdog, stuck job watchdog, change order overdue notifications, and workflow SLA breach sweep schedulers)\");
}

// Task #2668 — sweep helper. Exported so tests can drive it directly
// without spinning up the cron.
export interface AiTakeoffStallWatchdogSummary {
  scanned: number;
  flagged: number;
  stallTimeoutMs: number;
  /** Rows that looked stale by `progress_updated_at` but whose backing
   * pg-boss job is still active/created/retry, so we left them alone. */
  skippedJobActive: number;
}

export async function processAiTakeoffStallWatchdog(): Promise<AiTakeoffStallWatchdogSummary> {
  const stallTimeoutMs = Math.max(
    30_000,
    Number(process.env.AI_TAKEOFF_STALL_TIMEOUT_MS) || 5 * 60 * 1000,
  );

  const { aiTakeoffAnalyses } = await import(\"@shared/schema\");
  const { publishJobProgress, getBoss } = await import(\"../jobQueue\");

  const cutoff = new Date(Date.now() - stallTimeoutMs);

  // Match rows that are still in a non-terminal status AND haven't ticked
  // since the cutoff. We treat a NULL `progress_updated_at` as stalled
  // too — only happens if the worker crashed before the very first
  // tick, which is exactly the case we want to recover from.
  const stalled = await db.select()
    .from(aiTakeoffAnalyses)
    .where(and(
      inArray(aiTakeoffAnalyses.status, [\"PENDING\", \"PROCESSING\"]),
      or(
        isNull(aiTakeoffAnalyses.progressUpdatedAt),
        lt(aiTakeoffAnalyses.progressUpdatedAt, cutoff),
      ),
    ));

  let flagged = 0;
  let skippedJobActive = 0;
  // Resolve the pg-boss handle once so we can check job state before
  // we declare a row truly stalled. A row whose backing job is still
  // `created`/`active`/`retry` may simply be in the middle of a long
  // model call — we must not force-fail it.
  let boss: ReturnType<typeof getBoss> | null = null;
  try {
    boss = getBoss();
  } catch {
    boss = null;
  }
  const liveStates = new Set([\"created\", \"active\", \"retry\"]);
  for (const row of stalled) {
    try {
      if (boss && row.currentJobId) {
        try {
          const job = await boss.getJobById(\"ai_takeoff_analyze\", row.currentJobId, { includeArchive: true });
          // Only treat the row as stalled when the backing job is
          // demonstrably no longer making progress. `created`,
          // `active`, and `retry` all mean pg-boss still owns it.
          // `null` (job missing entirely) is treated as stalled —
          // that's the orphaned-row case we want the watchdog to
          // recover from.
          if (job && liveStates.has(String(job.state))) {
            skippedJobActive += 1;
            continue;
          }
        } catch (lookupErr) {
          logWarn(\"AI takeoff stall watchdog: pg-boss lookup failed, will still flip row\", {
            analysisId: row.id,
            jobId: row.currentJobId,
            error: lookupErr instanceof Error ? lookupErr.message : String(lookupErr),
          });
        }
      }
      // Conditional UPDATE so two concurrent watchdog ticks (across
      // pods that lost the leader race for a fraction of a second)
      // can't both publish a terminal SSE. The status check inside
      // the WHERE makes this idempotent.
      const updated = await db.update(aiTakeoffAnalyses)
        .set({
          status: \"FAILED\",
          errorMessage: \"Analysis stalled — no progress reported\",
          progressMessage: \"Analysis stalled — no progress reported\",
          progressUpdatedAt: new Date(),
          updatedAt: new Date(),
        })
        .where(and(
          eq(aiTakeoffAnalyses.id, row.id),
          inArray(aiTakeoffAnalyses.status, [\"PENDING\", \"PROCESSING\"]),
        ))
        .returning({ id: aiTakeoffAnalyses.id });

      if (updated.length === 0) continue;
      flagged += 1;

      // Best-effort terminal SSE. The owner is the analysis creator
      // (`createdByUserId`); when that's null (legacy rows) we fall
      // back to the first active admin in the org so the SSE has a
      // valid addressee.
      if (row.currentJobId && row.organizationId) {
        const ownerRow = row.createdByUserId
          ? [{ id: row.createdByUserId }]
          : await db.select({ id: users.id })
              .from(users)
              .where(and(
                eq(users.organizationId, row.organizationId),
                eq(users.isActive, true),
                inArray(users.role, [\"SUPER_ADMIN\", \"ADMIN\"]),
              ))
              .limit(1);
        const userId = ownerRow[0]?.id ?? null;
        if (userId) {
          await publishJobProgress({
            jobId: row.currentJobId,
            jobName: \"ai_takeoff_analyze\",
            organizationId: row.organizationId,
            userId,
            status: \"failed\",
            progress: row.progressPct ?? 0,
            message: \"Analysis stalled — no progress reported\",
          });
        }
      }
    } catch (err) {
      logError(\"AI takeoff stall watchdog row failed\", {
        analysisId: row.id,
        error: err instanceof Error ? err.message : String(err),
      });
    }
  }

  return { scanned: stalled.length, flagged, stallTimeoutMs, skippedJobActive };
}

// Task #2833 — Stuck pg-boss job watchdog.
// Per-job-type stall counters — incremented each time a job name appears in the
// pg-boss active-but-stalled query.  Exposed as job_stall_total{jobType=...}
// on the /metrics endpoint via getJobStallCounterSnapshot().
const _jobStallCounters = new Map<string, number>();

export function getJobStallCounterSnapshot(): Array<{ jobType: string; value: number }> {
  return Array.from(_jobStallCounters.entries()).map(([jobType, value]) => ({ jobType, value }));
}

// Scans for jobs stuck in 'active' state longer than JOB_STALL_MINUTES
// (preferred) or STUCK_JOB_THRESHOLD_MS (legacy fallback).
export async function processStuckJobWatchdog(): Promise<{ found: number }> {
  const thresholdMs = Math.max(
    60_000,
    // JOB_STALL_MINUTES is the canonical env var; STUCK_JOB_THRESHOLD_MS kept
    // as a legacy alias so existing deployments don't break.
    (Number(process.env.JOB_STALL_MINUTES) * 60_000) ||
    Number(process.env.STUCK_JOB_THRESHOLD_MS) ||
    30 * 60 * 1000, // default 30 min
  );
  const cutoff = new Date(Date.now() - thresholdMs);
  // Query pgboss schema directly — pg-boss does not expose a getDb() helper
  // so we use the same pool that powers Drizzle (same DATABASE_URL, same schema).
  let found = 0;
  try {
    const result = await db.execute(
      sql`SELECT id::text, name, state, started_on, data FROM pgboss.job WHERE state = 'active' AND started_on < ${cutoff} LIMIT 100`
    );
    const rows = result.rows as Array<{ id: string; name: string; state: string; started_on: Date; data: Record<string, unknown> | null }>;
    found = rows.length;
    if (rows.length > 0) {
      logWarn(\"Stuck pg-boss jobs detected\", {
        count: rows.length,
        thresholdMs,
        jobs: rows.map(r => ({ id: r.id, name: r.name, startedOn: r.started_on })),
      });
      // Emit per-job-type stall counters so ops dashboards can alert on
      // specific job types that are chronically stuck.
      for (const row of rows) {
        _jobStallCounters.set(row.name, (_jobStallCounters.get(row.name) ?? 0) + 1);
      }

      // Notify org admins per stuck job so the problem is surfaced in-app.
      const byOrg = new Map<string, string[]>();
      for (const row of rows) {
        const d = row.data ?? {};
        const orgId = (d.orgId ?? d.organizationId) as string | undefined;
        if (!orgId) continue;
        const names = byOrg.get(orgId) ?? [];
        names.push(row.name);
        byOrg.set(orgId, names);
      }
      if (byOrg.size > 0) {
        const stuckNotifs: InsertNotification[] = [];
        const minutesStuck = Math.round(thresholdMs / 60_000);
        for (const [orgId, jobNames] of byOrg) {
          const adminRows = await db.select({ id: users.id, email: users.email })
            .from(users)
            .where(and(
              eq(users.organizationId, orgId),
              inArray(users.role, [\"ADMIN\", \"SUPER_ADMIN\"]),
              eq(users.isActive, true),
            ))
            .limit(5);
          const label = jobNames.slice(0, 3).join(\", \") + (jobNames.length > 3 ? ` (+${jobNames.length - 3} more)` : \"\");
          const msgBody = `${jobNames.length} background job(s) have been active for more than ${minutesStuck} min: ${label}. Log in to the Job Queue admin page to investigate.`;
          for (const admin of adminRows) {
            stuckNotifs.push({
              userId: admin.id,
              organizationId: orgId,
              type: \"GENERAL\" as const,
              title: \"Stuck Background Jobs Detected\",
              message: msgBody,
            });
            // Also send email so the alert is not silently missed if the admin
            // isn't actively viewing the in-app notification panel.
            if (admin.email) {
              sendEmail({
                to: admin.email,
                subject: `[SmartManageAI] Stuck background job(s) detected`,
                html: `<p>${msgBody}</p><p><strong>Job names:</strong> ${label}</p><p>Visit the Job Queue admin page to retry or cancel stuck jobs.</p>`,
              }).catch((eErr) => {
                logWarn(\"Stuck job watchdog: email send failed\", { error: String(eErr), adminId: admin.id });
              });
            }
          }
        }
        if (stuckNotifs.length > 0) {
          await insertNotifications(stuckNotifs).catch((nErr) => {
            logWarn(\"Stuck job watchdog: failed to insert admin notifications\", { error: String(nErr) });
          });
        }
      }
    }
  } catch (queryErr) {
    // pgboss schema may not exist in environments without the queue running —
    // log and swallow so the watchdog tick doesn't crash the cron runner.
    logWarn(\"Stuck job watchdog: pgboss schema query failed (queue may not be started)\", {
      error: queryErr instanceof Error ? queryErr.message : String(queryErr),
    });
  }
  return { found };
}

// Task #2833 — Change order overdue notification sweep.
// Mirrors processRfiOverdueNotifications pattern for change orders.
export async function processChangeOrderOverdueNotifications(): Promise<{ notified: number }> {
  const now = new Date();

  // Per-org cap + interval — mirrors processRfiOverdueNotifications (Task #1599 pattern).
  // COALESCE guards against NULL despite NOT NULL DEFAULT on both org columns.
  const orgCapExpr = sql<number>`COALESCE(${organizations.docOverdueReminderMaxCount}, ${DOC_OVERDUE_REMINDER_DEFAULT_CAP})`;
  const orgIntervalExpr = sql<number>`COALESCE(${organizations.docOverdueReminderIntervalHours}, ${DOC_OVERDUE_REMINDER_DEFAULT_INTERVAL_HOURS})`;

  // changeOrders has no organizationId column; derive it via the project join.
  // There is also no `title` column — `changeOrderNumber` + `description` serve as the label.
  const overdueRows = await db
    .select({
      id: changeOrders.id,
      organizationId: projects.gcOrganizationId,
      projectManagerId: projects.projectManagerId,
      changeOrderNumber: changeOrders.changeOrderNumber,
      description: changeOrders.description,
      projectId: changeOrders.projectId,
      requestedById: changeOrders.requestedById,
      requiredResponseDate: changeOrders.requiredResponseDate,
      lastOverdueNotifiedAt: changeOrders.lastOverdueNotifiedAt,
      overdueReminderCount: changeOrders.overdueReminderCount,
      reminderMaxCount: orgCapExpr,
      reminderIntervalHours: orgIntervalExpr,
    })
    .from(changeOrders)
    .innerJoin(projects, eq(changeOrders.projectId, projects.id))
    .leftJoin(organizations, eq(projects.gcOrganizationId, organizations.id))
    .where(
      and(
        isNotNull(changeOrders.requiredResponseDate),
        lt(changeOrders.requiredResponseDate, now),
        or(
          isNull(changeOrders.lastOverdueNotifiedAt),
          and(
            sql`${changeOrders.overdueReminderCount} < ${orgCapExpr}`,
            sql`${changeOrders.lastOverdueNotifiedAt} <= (${now}::timestamp - (${orgIntervalExpr} * interval '1 hour'))`,
          ),
        ),
        inArray(changeOrders.status, [\"SUBMITTED\", \"PENDING_APPROVAL\"]),
      ),
    )
    .limit(200);

  if (overdueRows.length === 0) return { notified: 0 };

  const notifs: InsertNotification[] = [];
  const notifiedIds: string[] = [];

  for (const co of overdueRows) {
    // gcOrganizationId is nullable on projects; skip rows that have no GC org.
    const orgId = co.organizationId;
    if (!orgId) continue;

    const reminderNum = (co.overdueReminderCount ?? 0) + 1;
    const title = reminderNum === 1
      ? `Change Order Response Overdue`
      : `Change Order Response Overdue (Reminder #${reminderNum})`;
    const message = `Change Order ${co.changeOrderNumber ?? \"\"}${co.description ? ` – ${co.description.slice(0, 80)}` : \"\"} has passed its required response date and awaits client action.`;

    // Notify the CO author and project manager — not a broad org-wide broadcast.
    const recipientIds = new Set<string>();
    if (co.requestedById) recipientIds.add(co.requestedById);
    if (co.projectManagerId) recipientIds.add(co.projectManagerId);

    // Fallback: if neither is set (legacy rows), notify org ADMIN/MANAGER.
    if (recipientIds.size === 0) {
      const fallbackRows = await db
        .select({ id: users.id })
        .from(users)
        .where(and(
          eq(users.organizationId, orgId),
          inArray(users.role, [\"ADMIN\", \"MANAGER\"]),
          eq(users.isActive, true),
        ))
        .limit(5);
      fallbackRows.forEach((r) => recipientIds.add(r.id));
    }

    for (const uid of recipientIds) {
      notifs.push({
        userId: uid,
        organizationId: orgId,
        type: \"GENERAL\" as const,
        title,
        message,
        relatedEntityType: \"changeOrder\",
        relatedEntityId: co.id,
      });
    }
    notifiedIds.push(co.id);
  }

  if (notifs.length > 0) {
    await insertNotifications(notifs);
  }
  // Always increment overdueReminderCount so the cap logic is effective and
  // subsequent sweeps correctly classify follow-up vs initial notifications.
  if (notifiedIds.length > 0) {
    await db
      .update(changeOrders)
      .set({
        lastOverdueNotifiedAt: now,
        overdueReminderCount: sql`${changeOrders.overdueReminderCount} + 1`,
      })
      .where(inArray(changeOrders.id, notifiedIds));
  }

  if (notifs.length > 0) {
    logInfo(\"Change order overdue notifications sent\", {
      notifications: notifs.length,
      cos: notifiedIds.length,
    });
  }

  return { notified: notifiedIds.length };
}

