[31m+   }[39m
[31m+[39m
[31m+   const rows = await db.execute(sql`[39m
[31m+     SELECT organization_id,[39m
[31m+            trade_type,[39m
[31m+            CASE[39m
[31m+              WHEN confidence >= 90 THEN 90[39m
[31m+              WHEN confidence >= 80 THEN 80[39m
[31m+              WHEN confidence >= 70 THEN 70[39m
[31m+              ELSE 60[39m
