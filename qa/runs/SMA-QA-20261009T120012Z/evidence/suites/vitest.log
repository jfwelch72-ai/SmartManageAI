[31m+       return res.status(401).json({ error: "Unauthorized" });[39m
[31m+     }[39m
[31m+[39m
[31m+     const [analysis] = await db.select()[39m
[31m+       .from(aiTakeoffAnalyses)[39m
[31m+       .where(and([39m
[31m+         eq(aiTakeoffAnalyses.id, req.params.analysisId),[39m
[31m+         eq(aiTakeoffAnalyses.organizationId, organizationId)[39m
[31m+       ));[39m
[31m+[39m
[31m+     if (!analysis) {[39m
[31m+       return res.status(404).json({ error: "Analysis not found" });[39m
[31m+     }[39m
[31m+[39m
[31m+     const detectedItems = analysis.detectedItemsJson ? JSON.parse(analysis.detectedItemsJson) : [];[39m
[31m+     const metadata = analysis.metadataJson ? JSON.parse(analysis.metadataJson) : {};[39m
[31m+[39m
[31m+     res.json({[39m
[31m+       analysisId: analysis.id,[39m
[31m+       status: analysis.status,[39m
[31m+       tradeType: analysis.tradeType,[39m
[31m+       detectedItems,[39m
[31m+       metadata,[39m
[31m+       aiNotes: analysis.aiNotes,[39m
[31m+       processingTimeMs: analysis.processingTimeMs,[39m
[31m+       // Task #2668 — fields needed for the panel to rehydrate after a[39m
[31m+       // hard reload and to fall back to polled progress when SSE is[39m
[31m+       // unavailable. `currentJobId` lets the client re-subscribe to[39m
[31m+       // the live SSE channel; `progressPct` / `progressMessage` /[39m
[31m+       // `progressUpdatedAt` feed the polled fallback bar; and[39m
[31m+       // `errorMessage` powers the failure card.[39m
[31m+       currentJobId: analysis.currentJobId ?? null,[39m
[31m+       progressPct: analysis.progressPct ?? null,[39m
[31m+       progressMessage: analysis.progressMessage ?? null,[39m
[31m+       progressUpdatedAt: analysis.progressUpdatedAt ?? null,[39m
