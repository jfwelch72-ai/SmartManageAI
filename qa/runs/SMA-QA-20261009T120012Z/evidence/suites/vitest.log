[31m+ router.get([39m
[31m+   "/ai-features/takeoff/suggestions/by-analysis/:analysisId",[39m
[31m+   requireAuth,[39m
[31m+   async (req: AuthRequest, res, next) => {[39m
[31m+     try {[39m
[31m+       const organizationId = req.user?.organizationId;[39m
