[31m+         if (!Number.isFinite(orig) || !Number.isFinite(edited) || orig === 0) return false;[39m
[31m+         return Math.abs(edited - orig) / Math.abs(orig) > FEW_SHOT_QTY_DELTA_THRESHOLD;[39m
[31m+       })[39m
